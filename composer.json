{
    "name": "ambercouch/ac-advanced-flamingo-settings",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=7.4",
        "deliciousbrains/wp-background-processing": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "ACAFS\\": "lib/",
            "ACAFS\\Admin\\": "lib/Admin/",
            "ACAFS\\Admin\\Flamingo\\": "lib/Admin/Flamingo/"
        }
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "phpstan/phpstan": "^1.11",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "wp-coding-standards/wpcs": "^3.1",
        "php-stubs/wordpress-stubs": "6.7.*",
        "php-stubs/wp-cli-stubs": "2.12.*",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "phpcompatibility/php-compatibility": "^9.3"
    },
    "scripts": {
        "lint": "phpcs",
        "fix": "phpcbf",
        "stan": "phpstan analyse",
        "compat": "phpcs --standard=PHPCompatibility --runtime-set testVersion 7.4- --extensions=php --ignore=\"*/vendor/*,*/build/*\" ."
    },
    "extra": {
        "phpcodesniffer-standard": "WordPress-Extra"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "license": "GPL-2.0-or-later"
}
